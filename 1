import math

def circle_area(radius):
    area = math.pi * radius * radius
    return area

def rectangle_area(width, height):
    area = width * height
    return area

def triangle_area(base, height):
    area = (base * height) / 2
    return area

print("Калькулятор площі фігур")
print("1 - Коло")
print("2 - Прямокутник")
print("3 - Трикутник")

choice = 1
print("Оберіть фігуру (1-3):", choice)

if choice == 1:
    r = 5.0
    print("Введіть радіус:", r)
    result = circle_area(r)
    print("Площа кола =", round(result, 2))

elif choice == 2:
    w = 4.0
    h = 6.0
    print("Введіть ширину:", w)
    print("Введіть висоту:", h)
    result = rectangle_area(w, h)
    print("Площа прямокутника =", round(result, 2))

elif choice == 3:
    b = 8.0
    h = 3.0
    print("Введіть основу:", b)
    print("Введіть висоту:", h)
    result = triangle_area(b, h)
    print("Площа трикутника =", round(result, 2))

else:
    print("Невірний вибір")
